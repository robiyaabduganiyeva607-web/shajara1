{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shajara1",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Baza birinchi deployda avtomatik yaratiladi (wrangler >= 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "shajara-db","database_id": "86a02bb9-9845-456d-b528-ca0a59c19c53" }],
  "observability": { "enabled": true }
}
